# Copy to .env (gitignored) or fill it from azd after `azd provision`:
#   azd env get-values | Out-File -Encoding utf8 .env
# No secrets here: the Foundry resource has keys off and the tool signs in with Microsoft Entra ID
# (az login).

# Engine "speech" (Azure Speech voices)
FOUNDRY_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>
FOUNDRY_REGION=eastus2
# Optional: a full text to speech URL that replaces the regional one built from FOUNDRY_REGION.
# FOUNDRY_SPEECH_ENDPOINT=

# Engine "openai" (gpt-4o-mini-tts deployment)
FOUNDRY_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
FOUNDRY_TTS_DEPLOYMENT=gpt-4o-mini-tts
